# 複製成 .env 後填入實際值。.env 不要 commit 進 git。

# CMS 後台登入帳密
CMS_USERNAME=admin
CMS_PASSWORD=change_me

# GitHub fine-grained personal access token
# 權限只需要 acm-backup 這一個 repo 的 Contents: Read and write
GITHUB_TOKEN=

# 備份 repo 位址（不含 https:// 與帳密部分）
BACKUP_REPO_URL=github.com/NCNU-ACM/acm-backup.git
GIT_BRANCH=main

# 自動 commit 時使用的身分
GIT_USER_NAME=ACM CMS Bot
GIT_USER_EMAIL=cms-bot@ncnu-acm.local
