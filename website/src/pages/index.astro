---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/content/home/HeroSection.tsx';
import GroupsSection from '../components/content/home/GroupsSection.tsx';
import UpcomingEvents from '../components/content/home/UpcomingEvents.tsx';
import EventReview from '../components/content/home/EventReview.tsx';
import JoinSection from '../components/content/home/JoinSection.tsx';
import { getCollection } from 'astro:content';

const allGroups = await getCollection('groups');
const groups = allGroups
  .map(g => ({
    name: g.data.name,
    slug: g.data.slug,
    order: g.data.order,
    tagline: g.data.tagline,
    description: g.data.description,
    color: g.data.color,
  }))
  .sort((a, b) => a.order - b.order);

const allEvents = await getCollection('events');
const today = new Date();

const upcoming = allEvents
  .map(e => ({
    id: e.id,
    title: e.data.title,
    date: e.data.event_date.toLocaleDateString('zh-TW'),
    dateValue: e.data.event_date.valueOf(),
    type: e.data.type,
    group: e.data.group,
    location: e.data.location,
    description: e.data.description,
    content: e.data.content,
    links: e.data.links || [],
    registration: e.data.registration,
  }))
  .filter(e => e.dateValue >= today.valueOf())
  .sort((a, b) => a.dateValue - b.dateValue)
  .slice(0, 3);

const past = allEvents
  .map(e => ({
    id: e.id,
    title: e.data.title,
    date: e.data.event_date.toLocaleDateString('zh-TW'),
    dateValue: e.data.event_date.valueOf(),
    type: e.data.type,
    group: e.data.group,
    location: e.data.location,
    description: e.data.description,
    content: e.data.content,
    links: e.data.links || [],
    registration: e.data.registration,
  }))
  .filter(e => e.dateValue < today.valueOf())
  .sort((a, b) => b.dateValue - a.dateValue)
  .slice(0, 6);

const allShowcase = await getCollection('showcase');
const showcaseItems = allShowcase.map(s => ({
  id: s.id,
  title: s.data.title,
  group: s.data.group,
  date: s.data.date.toLocaleDateString('zh-TW'),
  description: s.data.description,
  related_event: s.data.related_event,
  cover_image: s.data.cover_image,
  gallery: s.data.gallery || [],
  tags: s.data.tags || [],
  links: s.data.links || [],
}));
---

<BaseLayout>
  <div id="fullpage">
    <div class="section"><HeroSection client:load /></div>
    <div class="section"><GroupsSection groups={groups} client:load /></div>
    <div class="section">
      <UpcomingEvents events={upcoming} groups={groups} showcaseItems={showcaseItems} client:load />
    </div>
    <div class="section">
      <EventReview events={past} groups={groups} showcaseItems={showcaseItems} client:load />
    </div>
    <div class="section"><JoinSection client:load /></div>
  </div>
</BaseLayout>

<script>
  // 【內部機制】首頁的整頁捲動（滾輪或方向鍵一次換一個 section）與右側導覽圓點。
  // 修改前先讀 src/components/internal/README.md。
  //
  // 為什麼不能簡化：
  // - wheel 監聽必須是 { passive: false } 並呼叫 preventDefault，才能擋掉瀏覽器原生的捲動。
  //   改成 passive 或拿掉 preventDefault，一次滾輪會同時觸發原生捲動與換頁，畫面停在兩個 section 中間。
  // - isScrolling 加上 800ms 冷卻：觸控板一次滑動會送出幾十個 wheel 事件，沒有冷卻會一次跳過好幾頁。
  // - target.closest('.modal') 讓活動 modal 裡可以正常捲動；modal 開著時方向鍵也只捲 modal、不換頁。
  //   EventModal 為此保留了字面 class `modal`，兩邊要一起改；ShowcaseModal 沒有這個 class，所以不能直接搬到首頁使用。
  // - scrollRestoration 設為 manual 並捲回頂端：currentIndex 從 0 開始算，若瀏覽器把位置還原到中間，
  //   索引與畫面會對不上，下一次滾輪會跳到錯的 section。
  // - 方向鍵換頁聽的是 window 的 keydown。useEscapeKey 刻意不 stopPropagation，就是為了不擋到這裡。
  //   keydown 也要對 ↑↓ 呼叫 preventDefault，理由同 wheel：原生捲動會打斷換頁的平滑捲動（例外見該段註解）。
  //
  // 改了會壞掉什麼：首頁的滾輪與方向鍵換頁、導覽圓點的狀態、首頁 modal 內的捲動。
  // 每個 section 的高度由下方 <style> 的 .section（height: 100vh）決定，改動高度也會讓換頁的停靠位置錯開。
  if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }
  window.scrollTo(0, 0);

  const sections = document.querySelectorAll('.section');
  let currentIndex = 0;
  let isScrolling = false;

  const getSectionTop = (index: number) => {
    return (sections[index] as HTMLElement).getBoundingClientRect().top + window.scrollY;
  };

  const goToSection = (index: number) => {
    if (index < 0 || index >= sections.length) return;
    currentIndex = index;

    if (index === 0) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      window.scrollTo({ top: getSectionTop(index), behavior: 'smooth' });
    }

    document.querySelectorAll('.nav-dot').forEach((dot, i) => {
      const d = dot as HTMLElement;
      if (i === currentIndex) {
        d.style.background = 'rgba(59,130,246,0.9)';
        d.style.transform = 'scale(1.3)';
      } else {
        d.style.background = 'rgba(255,255,255,0.3)';
        d.style.transform = 'scale(1)';
      }
    });
  };

  let wheelTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener('wheel', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.modal')) {
      return;
    }

    e.preventDefault();
    if (isScrolling) return;
    
    isScrolling = true;
    if (e.deltaY > 0) {
      goToSection(currentIndex + 1);
    } else {
      goToSection(currentIndex - 1);
    }
    
    setTimeout(() => { isScrolling = false; }, 800);
  }, { passive: false });

  window.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;

    // modal 開著時 ↑↓ 只捲 modal 內容、不換頁，與滾輪的 closest('.modal') 一致，靠的是同一個字面 class `modal`。
    // keydown 的 target 是有焦點的元素，modal 裡沒有可聚焦的元素，target 一律是 body，
    // 所以不能用 e.target.closest('.modal')，改成檢查頁面上有沒有 .modal。
    // 焦點不在 modal 內時，瀏覽器原生的方向鍵不會捲它（剛點卡片開啟時就是這樣），所以這裡自己捲，
    // 並擋掉原生行為，避免點過 modal 內部後原生捲動與這裡重複。步距 40px 與原生方向鍵相同。
    const modal = document.querySelector('.modal');
    if (modal) {
      e.preventDefault();
      modal.scrollBy({ top: e.key === 'ArrowDown' ? 40 : -40, behavior: 'smooth' });
      return;
    }

    // 擋掉方向鍵原生的 40px 捲動：它會打斷 goToSection 的平滑捲動，畫面停在半途而 currentIndex 已經加 1，
    // 下一次滾輪就會跳過一頁。要放在 isScrolling 檢查之前，冷卻期間按方向鍵也會打斷滾輪觸發的捲動。
    // 焦點在輸入框時不擋，讓游標能照常移動。
    const target = e.target;
    if (!(target instanceof Element && target.closest('input, textarea, select, [contenteditable]'))) {
      e.preventDefault();
    }

    if (isScrolling) return;
    if (e.key === 'ArrowDown') goToSection(currentIndex + 1);
    if (e.key === 'ArrowUp') goToSection(currentIndex - 1);
  });

  const nav = document.createElement('div');
  nav.style.cssText = 'position:fixed;right:1.5rem;top:50%;transform:translateY(-50%);z-index:100;display:flex;flex-direction:column;gap:0.75rem;';
  
  sections.forEach((_, i) => {
    const dot = document.createElement('div');
    dot.className = 'nav-dot';
    dot.style.cssText = `width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,0.3);cursor:pointer;transition:all 0.3s;`;
    if (i === 0) {
      dot.style.background = 'rgba(59,130,246,0.9)';
      dot.style.transform = 'scale(1.3)';
    }
    dot.addEventListener('click', () => goToSection(i));
    nav.appendChild(dot);
  });
  document.body.appendChild(nav);
</script>

<style>
  .section {
    height: 100vh;
    overflow: hidden;
  }
  .nav-dot.active {
    background: rgba(59, 130, 246, 0.9) !important;
    transform: scale(1.3) !important;
  }
  html {
    scrollbar-width: none;
  }
  html::-webkit-scrollbar {
    display: none;
  }
</style>