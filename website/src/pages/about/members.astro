---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Background from '../../components/common/Background.tsx';
import MembersCarousel from '../../components/about/MembersCarousel.tsx';
import { getCollection } from 'astro:content';

const allMembers = await getCollection('members');
const allGroups = await getCollection('groups');
const groups = allGroups.map(g => ({ slug: g.data.slug, name: g.data.name }));

const membersWithSemester = allMembers.map(m => ({
  id: m.id,
  semester: m.id.split('/')[0],
  name: m.data.name,
  group: m.data.group,
  role: m.data.role,
  bio: m.data.bio,
  avatar: m.data.avatar,
  contact: m.data.contact || [],
}));

const semesters = [...new Set(membersWithSemester.map(m => m.semester))].sort().reverse();
const latestSemester = semesters[0];
---

<BaseLayout title="成員介紹">
  <div class="page-container">
    <Background client:load />
    <div class="relative z-10">
      <div class="hero-area">
        <p class="text-sm tracking-widest mb-2 section-label">OUR TEAM</p>
        <h1 class="page-title text-5xl md:text-6xl font-bold">成員介紹</h1>
      </div>

      <MembersCarousel
        members={membersWithSemester}
        semesters={semesters}
        latestSemester={latestSemester}
        groups={groups}
        client:load
      />
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    position: relative;
    min-height: 100vh;
    background: linear-gradient(to top, #030b23 0%, #063238 100%);
    padding-top: 6rem;
    padding-bottom: 6rem;
    overflow: hidden;
  }

  .hero-area {
    text-align: center;
    padding: 0 2rem 3rem;
  }

  .page-title {
    background: linear-gradient(to top right, #3b82f6 0%, #34d399 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0 12px rgba(59, 130, 246, 0.6))
      drop-shadow(0 0 25px rgba(52, 211, 153, 0.4))
      drop-shadow(2px 4px 0px rgba(0, 0, 0, 0.6));
  }

  .section-label {
    color: rgba(96, 165, 250, 0.8);
    text-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
  }
</style>