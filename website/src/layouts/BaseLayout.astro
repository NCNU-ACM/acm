---
import { getCollection } from 'astro:content';
import Navbar from '../components/common/Navbar.tsx';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = '國立暨南國際大學 ACM 學生分會，涵蓋演算法、系統、接案、遊戲等小組，定期舉辦讀書會、講座與競賽。',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const SITE_NAME = 'NCNU ACM';

// 沒有傳 title 的頁面（例如首頁）只顯示站名，避免變成 "NCNU ACM | NCNU ACM"
const pageTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} 國立暨南國際大學 ACM 學生分會`;

// canonical 與 og:image 需要絕對網址，來源是 astro.config.ts 的 site 設定
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const currentYear = new Date().getFullYear();

const allGroups = await getCollection('groups');
const groups = allGroups
  .map(g => ({
    name: g.data.name,
    slug: g.data.slug,
    order: g.data.order,
    tagline: g.data.tagline,
    description: g.data.description,
    color: g.data.color,
  }))
  .sort((a, b) => a.order - b.order);
---

<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph：分享到 Discord、Facebook、LINE 時的預覽卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
  </head>
  <body>
    <Navbar groups={groups} client:load />
    <main style="padding-top: var(--navbar-height);">
      <slot />
    </main>
    <footer style="border-top: 1px solid var(--color-border); padding: 2rem; text-align: center; color: var(--color-text-muted);">
      © {currentYear} NCNU ACM. All rights reserved.
    </footer>
  </body>
</html>